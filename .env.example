# ============================================================
#  연금 코파일럿 — 환경변수 템플릿 (이 파일은 커밋됨, 실제 키 넣지 말 것)
#  사용법: 복사해서 .env 를 만들고 실제 값을 채운다.
#     Mac/Linux:  cp .env.example .env
#     Windows PS: Copy-Item .env.example .env
#  ⚠️ .env 는 절대 커밋 금지 (.gitignore 로 차단). 실제 키는 각자 로컬에만.
#
#  ※ 참고: Codex / OpenAI 로그인은 여기가 아니라 CLI 자체(`codex` 로그인 /
#     전역 ~/.codex) 에서 처리된다. 이 .env 는 "앱 실행 시" 쓰는 값만.
# ============================================================

# ── LLM 하네스 (Claude API) ──
# 역할: 엔진이 낸 수치의 "자연어 서술 + Q&A" 만. 계산·판단은 규칙 엔진(LLM 계산 금지).
ANTHROPIC_API_KEY=                 # 발급: https://console.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5    # 서술/대화 기본. 복잡추론 필요 시 claude-opus-4-8
# 테스트·정상화 기간에는 false 유지. true일 때만 서버가 Claude API를 호출한다.
ENABLE_CLAUDE_NARRATION=false

# ── 데이터 소스 ──
# 금감원 통합연금포털 Open API — 상품별 수익률(수수료차감후)·수수료율 공시 (★실데이터 핵심)
PENSION_PORTAL_API_KEY=            # 발급: https://100lifeplan.fss.or.kr
# NAVER API HUB 검색 API — 서버에서만 사용(브라우저 노출 금지)
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=
# 구형 developers.naver.com 검색 API를 병행할 때만 사용
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
# KRX OpenAPI — ETF 일별 종가·NAV·거래대금·순자산 (보수·적격성은 별도)
KRX_API_KEY=
# Korea Investment & Securities Open Trading API (server-side only)
KIS_APP_KEY=
KIS_APP_SECRET=
# 국가법령정보 공동활용 Open API - 퇴직연금 관련 행정규칙 조회
LAW_OPEN_API_KEY=                  # 발급: https://open.law.go.kr
# FSC Public Data Portal: Fund Product Basic Information
FSC_FUND_PRODUCT_API_KEY=
# OpenDART - ETF 투자설명서·집합투자증권 공시 원문 검증
DART_API_KEY=                       # 발급: https://opendart.fss.or.kr

# ── Supabase PostgreSQL ──
# FastAPI 서버용 직접 연결 문자열. CLI 인자나 프론트엔드에 넣지 않는다.
DATABASE_URL=
# 프론트엔드는 Auth 용도의 publishable key만 사용한다.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# 서버 전용 Secret/Service Role 키. 필요한 배포 환경에서만 설정하고 브라우저 노출 금지.
SUPABASE_SECRET_KEY=

# ── 앱 설정 ──
APP_ENV=development                # development | production
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
# FastAPI CORS 허용 오리진. JSON 배열 형식. 운영 환경에서는 실제 프론트엔드 도메인만 허용한다.
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# 사용자 계좌 = 시나리오 목데이터 3종(마이데이터 대체). 실계좌 연동 전까지 true 유지.
USE_MOCK_ACCOUNT_DATA=true
