# ============================================================
#  연금 코파일럿 — 환경변수 템플릿 (이 파일은 커밋됨, 실제 키 넣지 말 것)
#  사용법: 복사해서 .env 를 만들고 실제 값을 채운다.
#     Mac/Linux:  cp .env.example .env
#     Windows PS: Copy-Item .env.example .env
#  ⚠️ .env 는 절대 커밋 금지 (.gitignore 로 차단). 실제 키는 각자 로컬에만.
#
#  ※ 참고: Codex / OpenAI 로그인은 여기가 아니라 CLI 자체(`codex` 로그인 /
#     전역 ~/.codex) 에서 처리된다. 이 .env 는 "앱 실행 시" 쓰는 값만.
# ============================================================

# ── LLM 하네스 ──
# 역할: 엔진이 낸 수치의 "자연어 서술 + Q&A" 만. 계산·판단은 규칙 엔진(LLM 계산 금지).
# 모델 이름 접두사로 벤더를 고른다(claude -> Anthropic, gemini -> Google).
# 고른 벤더의 API 키가 있어야 호출된다.
ANTHROPIC_API_KEY=                 # 발급: https://console.anthropic.com
GOOGLE_API_KEY=                    # 발급: https://aistudio.google.com/apikey
CHAT_MODEL=gemini-3.5-flash-lite
# 근거 2건 이상인 계좌 규칙 답변에만 쓰는 상위 내레이션 모델(응답이 약 3초
# 느려지는 대신 비교·경계 서술 품질이 올라간다).
# CHAT_MODEL과 같은 값으로 두거나 비우면 단일 모델로만 동작한다.
NARRATION_UPGRADED_MODEL=
TOPIC_GUARD_MODEL=gemini-3.5-flash-lite
NEWS_SUMMARY_MODEL=gemini-3.6-flash # 기사 원문 3줄 요약 전용 Google GA 모델
NEWS_SUMMARY_PROMPT_VERSION=news-summary-v4
# Hugging Face 모델 다운로드·조회 rate limit 완화용 토큰(선택, 서버 전용)
HF_TOKEN=
# 테스트·정상화 기간에는 false 유지. true일 때만 서버가 LLM API를 호출한다.
ENABLE_LLM_NARRATION=false
# 1차 룰에서 UNSUPPORTED가 된 질문만 작은 모델로 짧게 재분류한다.
ENABLE_LLM_TOPIC_GUARD=false
# ETF 상품 특징 문구 생성. 비활성화하면 저장된 특징만 사용한다.
ENABLE_ETF_PRODUCT_FEATURE_GENERATION=true
# 검증 통과 내레이션의 서버 로컬 영속 캐시(DB 저장 금지)
NARRATION_CACHE_PATH=data/cache/narration_cache.json

# ── 데이터 소스 ──
# 금감원 통합연금포털 Open API — 상품별 수익률(수수료차감후)·수수료율 공시 (★실데이터 핵심)
PENSION_PORTAL_API_KEY=            # 발급: https://100lifeplan.fss.or.kr
# NAVER API HUB 검색 API — 서버에서만 사용(브라우저 노출 금지)
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=
# KRX OpenAPI — ETF 일별 종가·NAV·거래대금·순자산 (보수·적격성은 별도)
KRX_API_KEY=
# Korea Investment & Securities Open Trading API (server-side only)
KIS_APP_KEY=
KIS_APP_SECRET=
# 국가법령정보 공동활용 Open API - 퇴직연금 관련 행정규칙 조회
LAW_OPEN_API_KEY=                  # 발급: https://open.law.go.kr
# FSC Public Data Portal: Fund Product Basic Information
FSC_FUND_PRODUCT_API_KEY=
# FSC Public Data Portal: Stock Dividend Information (server-side only)
FSC_STOCK_DIVIDEND_API_KEY=
# OpenDART - ETF 투자설명서·집합투자증권 공시 원문 검증
DART_API_KEY=                       # 발급: https://opendart.fss.or.kr
# 한국은행 ECOS — 기준금리·소비자물가지수 과거 관측
BOK_ECOS_API_KEY=                   # 발급: https://ecos.bok.or.kr/api/
# KOSIS — 대한민국 65세 기대수명 과거 관측
KOSIS_API_KEY=                      # 발급: https://kosis.kr/openapi/
# FRED — 미국 금리·물가 과거 관측(글로벌 시장 설명 보조)
FRED_API_KEY=                       # 발급: https://fred.stlouisfed.org/docs/api/api_key.html
# FastAPI·챗봇이 읽는 정제 거시지표 보고서(원본 API 응답은 외부에 노출하지 않음)
MACRO_EVIDENCE_REPORT_PATH=data/cache/macro/macro_evidence_latest.json

# ── Supabase PostgreSQL ──
# FastAPI 서버용 직접 연결 문자열. CLI 인자나 프론트엔드에 넣지 않는다.
# Supabase transaction pooler(포트 6543)를 사용한다. 세션 풀러(5432)는 연결을
# 통째로 오래 붙잡아 15개 상한(EMAXCONNSESSION)에 쉽게 걸리므로 6543을 권장한다.
# 예: postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Per-API-process PostgreSQL connection limit. Keep this within the shared
# Supabase session-pool budget after reserving connections for workers and jobs.
DATABASE_POOL_MAX_SIZE=5
# 프론트엔드는 Auth 용도의 publishable key만 사용한다.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# 서버 전용 Secret/Service Role 키. 필요한 배포 환경에서만 설정하고 브라우저 노출 금지.
SUPABASE_SECRET_KEY=

# ── 프론트엔드(Vite) 공개 변수 ──
# ⚠️ VITE_ 접두사가 붙은 값만 브라우저 번들에 노출된다(위 서버 비밀키는 절대 노출 안 됨).
# vite.config.ts 의 envDir:".." 설정으로 프론트도 이 루트 .env 하나만 참조한다.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# ── 앱 설정 ──
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
# 로컬 챗 디버그 JSONL 기록. 평소에는 0으로 유지한다.
CHAT_DEBUG_LOG=0
# FastAPI CORS 허용 오리진. JSON 배열 형식. 운영 환경에서는 실제 프론트엔드 도메인만 허용한다.
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:5174","http://localhost:5174"]

# 시연·테스트 전용 계정(설문 결과를 저장하지 않음). 쉼표 구분 Supabase auth user id.
# 비워두면 모든 사용자의 설문이 평소대로 저장된다.
EPHEMERAL_INVESTMENT_PROFILE_OWNER_IDS=
